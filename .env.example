# Copy to .env and fill in values. Never commit .env.
#
# EAS cloud builds do NOT read this file. Set the same EXPO_PUBLIC_* values for
# preview/production at https://expo.dev (Project → Environment variables) or:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value ... --environment preview
#   eas env:pull --environment preview   # sync to .env.local for local testing

# --- Supabase (required for auth & database) ---
# https://supabase.com → Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenStreetMap routing (optional) ---
# Public OSRM instance; use your own server for production traffic.
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org

# --- Analytics (optional) ---
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- SERVER ONLY — Supabase Dashboard → Edge Functions → Secrets ---
# GROQ_API_KEY=              # Chat, plan-trip, transcribe (required)
