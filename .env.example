# Copy to .env and fill in values. Never commit .env.

# --- Supabase (required for auth & database) ---
# https://supabase.com → Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenStreetMap tiles (optional) ---
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAPTILER_API_KEY=

# --- Routing (optional) ---
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org

# --- Analytics (optional) ---
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- SERVER ONLY — Supabase Dashboard → Edge Functions → Secrets ---
# GROQ_API_KEY=              # Chat, plan-trip, transcribe (required)
